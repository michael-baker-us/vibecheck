{
  "name": "vibecheck",
  "displayName": "VibeCheck",
  "description": "Local engineering confidence for AI-assisted coding.",
  "version": "0.6.10",
  "private": true,
  "publisher": "local",
  "license": "UNLICENSED",
  "files": [
    "dist/**",
    "docs/images/**",
    "resources/**",
    "README.md",
    "DEVELOPMENT.md",
    "PLAN.md"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibecheck.start",
        "title": "Start Observing",
        "category": "VibeCheck",
        "icon": "$(play)"
      },
      {
        "command": "vibecheck.pause",
        "title": "Pause Observation",
        "category": "VibeCheck",
        "icon": "$(debug-pause)"
      },
      {
        "command": "vibecheck.refresh",
        "title": "Refresh Workspace State",
        "category": "VibeCheck",
        "icon": "$(refresh)"
      },
      {
        "command": "vibecheck.refreshProviderUsage",
        "title": "Refresh Claude and Codex Usage",
        "category": "VibeCheck",
        "icon": "$(pulse)"
      },
      {
        "command": "vibecheck.selectPlan",
        "title": "Choose Active Plan Document",
        "category": "VibeCheck",
        "icon": "$(list-tree)"
      },
      {
        "command": "vibecheck.openPlan",
        "title": "Open Active Plan Document",
        "category": "VibeCheck",
        "icon": "$(go-to-file)"
      },
      {
        "command": "vibecheck.runVerification",
        "title": "Run Verification",
        "category": "VibeCheck",
        "icon": "$(run)"
      },
      {
        "command": "vibecheck.runAllVerification",
        "title": "Run All Verification",
        "category": "VibeCheck",
        "icon": "$(beaker)"
      },
      {
        "command": "vibecheck.runCodeReview",
        "title": "Run Code Review",
        "category": "VibeCheck",
        "icon": "$(eye)"
      },
      {
        "command": "vibecheck.clearCodeReview",
        "title": "Clear Current Code Review",
        "category": "VibeCheck",
        "icon": "$(clear-all)"
      },
      {
        "command": "vibecheck.inspectCodeReviewFinding",
        "title": "Inspect Code Review Finding",
        "category": "VibeCheck"
      },
      {
        "command": "vibecheck.previewCodeReview",
        "title": "Preview Code Review Report",
        "category": "VibeCheck",
        "icon": "$(preview)"
      },
      {
        "command": "vibecheck.summarizeChanges",
        "title": "Create Markdown Change Summary",
        "category": "VibeCheck",
        "icon": "$(markdown)"
      },
      {
        "command": "vibecheck.maintainReadme",
        "title": "Generate or Maintain README",
        "category": "VibeCheck",
        "icon": "$(book)"
      },
      {
        "command": "vibecheck.showVerificationOutput",
        "title": "Show Verification Output",
        "category": "VibeCheck",
        "icon": "$(output)"
      },
      {
        "command": "vibecheck.inspectFinding",
        "title": "Inspect Finding",
        "category": "VibeCheck"
      },
      {
        "command": "vibecheck.acceptFinding",
        "title": "Accept as Intentional",
        "category": "VibeCheck",
        "icon": "$(pass)"
      },
      {
        "command": "vibecheck.dismissFinding",
        "title": "Dismiss Finding",
        "category": "VibeCheck",
        "icon": "$(close)"
      },
      {
        "command": "vibecheck.reopenFinding",
        "title": "Reopen Finding",
        "category": "VibeCheck",
        "icon": "$(history)"
      },
      {
        "command": "vibecheck.copyPrompt",
        "title": "Copy Suggested Agent Prompt",
        "category": "VibeCheck",
        "icon": "$(copy)"
      },
      {
        "command": "vibecheck.openConfig",
        "title": "Open Local Configuration",
        "category": "VibeCheck",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vibecheck.createSetupPrompt",
        "title": "Configure with Claude or Codex",
        "category": "VibeCheck",
        "icon": "$(sparkle)"
      },
      {
        "command": "vibecheck.createReport",
        "title": "Create Evidence Report",
        "category": "VibeCheck",
        "icon": "$(export)"
      },
      {
        "command": "vibecheck.manageAgentFile",
        "title": "Open Agent Workspace File",
        "category": "VibeCheck"
      },
      {
        "command": "vibecheck.generateAgentInstructions",
        "title": "Generate Claude and Codex Instruction Files",
        "category": "VibeCheck",
        "icon": "$(sparkle)"
      },
      {
        "command": "vibecheck.refreshAgentInstructions",
        "title": "Generate Claude and Codex Supporting Files",
        "category": "VibeCheck",
        "icon": "$(sparkle)"
      },
      {
        "command": "vibecheck.openAgentCapabilityTemplate",
        "title": "Open Agent Workspace Capability Template",
        "category": "VibeCheck",
        "icon": "$(new-file)"
      },
      {
        "command": "vibecheck.previewAgentInstruction",
        "title": "Preview Agent Workspace Proposal",
        "category": "VibeCheck",
        "icon": "$(diff)"
      },
      {
        "command": "vibecheck.applyAgentInstructionRefresh",
        "title": "Apply Agent Workspace Proposal",
        "category": "VibeCheck",
        "icon": "$(check)"
      },
      {
        "command": "vibecheck.discardAgentInstructionRefresh",
        "title": "Discard Agent Workspace Proposal",
        "category": "VibeCheck",
        "icon": "$(close)"
      },
      {
        "command": "vibecheck.alignAgentInstructions",
        "title": "Align Claude and Codex Workspace",
        "category": "VibeCheck",
        "icon": "$(sync)"
      },
      {
        "command": "vibecheck.clearAgentWorkspace",
        "title": "Clear Claude and Codex Workspace Files",
        "category": "VibeCheck",
        "icon": "$(trash)"
      },
      {
        "command": "vibecheck.installCodexAdapter",
        "title": "Install Local Codex Adapter",
        "category": "VibeCheck"
      },
      {
        "command": "vibecheck.installClaudeAdapter",
        "title": "Install Local Claude Adapter",
        "category": "VibeCheck"
      },
      {
        "command": "vibecheck.uninstallAgentAdapter",
        "title": "Remove Local Agent Adapter",
        "category": "VibeCheck"
      },
      {
        "command": "vibecheck.deleteData",
        "title": "Delete Local Observation Data",
        "category": "VibeCheck"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibecheck",
          "title": "VibeCheck",
          "icon": "resources/vibecheck.svg"
        }
      ]
    },
    "views": {
      "vibecheck": [
        {
          "id": "vibecheck.overview",
          "name": "Control Center",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vibecheck.refresh",
          "when": "view == vibecheck.overview",
          "group": "navigation"
        },
        {
          "command": "vibecheck.openPlan",
          "when": "view == vibecheck.overview",
          "group": "1_workflows@1"
        },
        {
          "command": "vibecheck.runAllVerification",
          "when": "view == vibecheck.overview",
          "group": "1_workflows@2"
        },
        {
          "command": "vibecheck.runCodeReview",
          "when": "view == vibecheck.overview",
          "group": "1_workflows@3"
        },
        {
          "command": "vibecheck.summarizeChanges",
          "when": "view == vibecheck.overview",
          "group": "1_workflows@4"
        },
        {
          "command": "vibecheck.maintainReadme",
          "when": "view == vibecheck.overview",
          "group": "1_workflows@5"
        },
        {
          "command": "vibecheck.copyPrompt",
          "when": "view == vibecheck.overview",
          "group": "2_evidence@1"
        },
        {
          "command": "vibecheck.openConfig",
          "when": "view == vibecheck.overview",
          "group": "3_configuration@1"
        },
        {
          "command": "vibecheck.generateAgentInstructions",
          "when": "view == vibecheck.overview",
          "group": "3_configuration@2"
        },
        {
          "command": "vibecheck.refreshAgentInstructions",
          "when": "view == vibecheck.overview",
          "group": "3_configuration@3"
        },
        {
          "command": "vibecheck.alignAgentInstructions",
          "when": "view == vibecheck.overview",
          "group": "3_configuration@4"
        }
      ]
    },
    "configuration": {
      "title": "VibeCheck",
      "properties": {
        "vibecheck.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Begin local repository observation automatically in Git workspaces."
        },
        "vibecheck.refreshDebounceMs": {
          "type": "number",
          "default": 750,
          "minimum": 100,
          "maximum": 10000,
          "description": "Delay before refreshing Git state after workspace file changes."
        },
        "vibecheck.alignAgentWorkspace": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Continuously align safe, portable Claude and Codex repository files. Shared instructions and one-sided open-standard skills sync automatically; incompatible provider-specific schemas are flagged for review."
        },
        "vibecheck.codexBalancedModel": {
          "type": "string",
          "default": "gpt-5.6-terra",
          "scope": "resource",
          "description": "Exact Codex model used for Balanced reviews, summaries, and README maintenance."
        },
        "vibecheck.codexDeepModel": {
          "type": "string",
          "default": "gpt-5.6-sol",
          "scope": "resource",
          "description": "Exact Codex model used for Deep reviews, summaries, and README maintenance."
        },
        "vibecheck.claudeBalancedModel": {
          "type": "string",
          "default": "claude-sonnet-5",
          "scope": "resource",
          "description": "Exact Claude model or alias used for Balanced reviews, summaries, and README maintenance."
        },
        "vibecheck.claudeDeepModel": {
          "type": "string",
          "default": "claude-opus-5",
          "scope": "resource",
          "description": "Exact Claude model or alias used for Deep reviews, summaries, and README maintenance."
        }
      }
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "compile": "npm run clean && tsc -p ./ && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=dist/extension.js",
    "watch": "concurrently --kill-others \"tsc -w --noEmit -p ./\" \"esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=dist/extension.js --watch\"",
    "check": "tsc --noEmit -p ./",
    "test": "npm run compile && node --test test/*.test.cjs",
    "coverage": "npm run compile && c8 --all --check-coverage --lines 80 --functions 75 --branches 60 --statements 80 --include='dist/adapters/adapter-installer.js' --include='dist/agent-instructions/**/*.js' --include='dist/analyzers/**/*.js' --include='dist/collectors/agent-file-collector.js' --include='dist/collectors/git-collector.js' --include='dist/collectors/plan-collector.js' --include='dist/config/**/*.js' --include='dist/domain/plans.js' --include='dist/domain/quality-gates.js' --include='dist/prompts/**/*.js' --include='dist/reports/**/*.js' --include='dist/verification/**/*.js' --reporter=text node --test test/*.test.cjs",
    "security": "npm audit --json --audit-level=high",
    "screenshots": "node docs/screenshots/capture.cjs",
    "verify": "npm run check && npm run coverage",
    "package:vsix": "npm run verify && mkdir -p packages && vsce package --out packages/vibecheck-${npm_package_version}.vsix --allow-missing-repository --skip-license --no-dependencies --no-rewrite-relative-links"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.9.2",
    "c8": "^12.0.0",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "minimatch": "^10.2.6",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0"
  }
}
