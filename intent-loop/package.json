{
  "name": "intent-loop",
  "displayName": "VibeCheck",
  "description": "Local engineering confidence for AI-assisted coding.",
  "version": "0.6.4",
  "private": true,
  "publisher": "local",
  "license": "UNLICENSED",
  "files": [
    "dist/**",
    "resources/**",
    "README.md",
    "DEVELOPMENT.md",
    "PLAN.md"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "intentLoop.start",
        "title": "Start Observing",
        "category": "VibeCheck",
        "icon": "$(play)"
      },
      {
        "command": "intentLoop.pause",
        "title": "Pause Observation",
        "category": "VibeCheck",
        "icon": "$(debug-pause)"
      },
      {
        "command": "intentLoop.refresh",
        "title": "Refresh Workspace State",
        "category": "VibeCheck",
        "icon": "$(refresh)"
      },
      {
        "command": "intentLoop.selectPlan",
        "title": "Choose Active Plan Document",
        "category": "VibeCheck",
        "icon": "$(list-tree)"
      },
      {
        "command": "intentLoop.openPlan",
        "title": "Open Active Plan Document",
        "category": "VibeCheck",
        "icon": "$(go-to-file)"
      },
      {
        "command": "intentLoop.runVerification",
        "title": "Run Verification",
        "category": "VibeCheck",
        "icon": "$(run)"
      },
      {
        "command": "intentLoop.runAllVerification",
        "title": "Run All Verification",
        "category": "VibeCheck",
        "icon": "$(beaker)"
      },
      {
        "command": "intentLoop.runCodeReview",
        "title": "Run Code Review",
        "category": "VibeCheck",
        "icon": "$(eye)"
      },
      {
        "command": "intentLoop.inspectCodeReviewFinding",
        "title": "Inspect Code Review Finding",
        "category": "VibeCheck"
      },
      {
        "command": "intentLoop.previewCodeReview",
        "title": "Preview Code Review Report",
        "category": "VibeCheck",
        "icon": "$(preview)"
      },
      {
        "command": "intentLoop.showVerificationOutput",
        "title": "Show Verification Output",
        "category": "VibeCheck",
        "icon": "$(output)"
      },
      {
        "command": "intentLoop.inspectFinding",
        "title": "Inspect Finding",
        "category": "VibeCheck"
      },
      {
        "command": "intentLoop.acceptFinding",
        "title": "Accept as Intentional",
        "category": "VibeCheck",
        "icon": "$(pass)"
      },
      {
        "command": "intentLoop.dismissFinding",
        "title": "Dismiss Finding",
        "category": "VibeCheck",
        "icon": "$(close)"
      },
      {
        "command": "intentLoop.reopenFinding",
        "title": "Reopen Finding",
        "category": "VibeCheck",
        "icon": "$(history)"
      },
      {
        "command": "intentLoop.copyPrompt",
        "title": "Copy Suggested Agent Prompt",
        "category": "VibeCheck",
        "icon": "$(copy)"
      },
      {
        "command": "intentLoop.openConfig",
        "title": "Open Local Configuration",
        "category": "VibeCheck",
        "icon": "$(settings-gear)"
      },
      {
        "command": "intentLoop.createReport",
        "title": "Create Evidence Report",
        "category": "VibeCheck",
        "icon": "$(export)"
      },
      {
        "command": "intentLoop.manageAgentFile",
        "title": "Open or Create Agent Workspace File",
        "category": "VibeCheck"
      },
      {
        "command": "intentLoop.installCodexAdapter",
        "title": "Install Local Codex Adapter",
        "category": "VibeCheck"
      },
      {
        "command": "intentLoop.installClaudeAdapter",
        "title": "Install Local Claude Adapter",
        "category": "VibeCheck"
      },
      {
        "command": "intentLoop.uninstallAgentAdapter",
        "title": "Remove Local Agent Adapter",
        "category": "VibeCheck"
      },
      {
        "command": "intentLoop.deleteData",
        "title": "Delete Local Observation Data",
        "category": "VibeCheck"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "intent-loop",
          "title": "VibeCheck",
          "icon": "resources/intent-loop.svg"
        }
      ]
    },
    "views": {
      "intent-loop": [
        {
          "id": "intentLoop.overview",
          "name": "Control Center",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "intentLoop.refresh",
          "when": "view == intentLoop.overview",
          "group": "navigation"
        },
        {
          "command": "intentLoop.openPlan",
          "when": "view == intentLoop.overview",
          "group": "navigation@2"
        },
        {
          "command": "intentLoop.runAllVerification",
          "when": "view == intentLoop.overview",
          "group": "navigation@3"
        },
        {
          "command": "intentLoop.runCodeReview",
          "when": "view == intentLoop.overview",
          "group": "navigation@4"
        },
        {
          "command": "intentLoop.copyPrompt",
          "when": "view == intentLoop.overview",
          "group": "navigation@5"
        },
        {
          "command": "intentLoop.openConfig",
          "when": "view == intentLoop.overview",
          "group": "navigation@6"
        }
      ]
    },
    "configuration": {
      "title": "VibeCheck",
      "properties": {
        "intentLoop.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Begin local repository observation automatically in Git workspaces."
        },
        "intentLoop.refreshDebounceMs": {
          "type": "number",
          "default": 750,
          "minimum": 100,
          "maximum": 10000,
          "description": "Delay before refreshing Git state after workspace file changes."
        }
      }
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "compile": "npm run clean && tsc -p ./ && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=dist/extension.js",
    "watch": "concurrently --kill-others \"tsc -w --noEmit -p ./\" \"esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=dist/extension.js --watch\"",
    "check": "tsc --noEmit -p ./",
    "test": "npm run compile && node --test test/*.test.cjs",
    "coverage": "npm run compile && c8 --all --check-coverage --lines 80 --functions 75 --branches 60 --statements 80 --include='dist/adapters/adapter-installer.js' --include='dist/analyzers/**/*.js' --include='dist/collectors/agent-file-collector.js' --include='dist/collectors/git-collector.js' --include='dist/collectors/plan-collector.js' --include='dist/config/**/*.js' --include='dist/domain/plans.js' --include='dist/domain/quality-gates.js' --include='dist/prompts/**/*.js' --include='dist/reports/**/*.js' --include='dist/verification/**/*.js' --reporter=text node --test test/*.test.cjs",
    "security": "npm audit --json --audit-level=high",
    "verify": "npm run check && npm run coverage",
    "package:vsix": "npm run verify && vsce package --out vibecheck-0.6.4.vsix --allow-missing-repository --skip-license --no-dependencies --no-rewrite-relative-links"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.9.2",
    "c8": "^12.0.0",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "minimatch": "^10.2.6",
    "yaml": "^2.9.0"
  }
}
